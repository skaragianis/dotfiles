{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "tmux-agent-sidebar@hiroppy": true,
    "cowork-plugin-management@synced": false,
    "productivity@synced": false,
    "cc-plugin-diff@builtin": false,
    "cc-plugin-privacy@builtin": false,
    "cc-plugin-plugin-authoring@builtin": false,
    "cc-plugin-telemetry@builtin": false
  },
  "extraKnownMarketplaces": {
    "hiroppy": {
      "source": {
        "source": "github",
        "repo": "hiroppy/tmux-agent-sidebar"
      }
    }
  },
  "effortLevel": "medium",
  "autoCompactWindow": 220000,
  "awaySummaryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "vim",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "includeGitInstructions": false,
  "enableArtifact": false,
  "disableBundledSkills": true,
  "disableWorkflows": true,
  "disableRemoteControl": false,
  "disableClaudeAiConnectors": true,
  "enableAllProjectMcpServers": true,
  "autoMemoryEnabled": true,
  "maxBashOutputLength": 15000,
  "spinnerTipsEnabled": false,
  "feedbackSurveyRate": 0,
  "feedbackDrafts": "off",
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "NotebookEdit",
      "CronCreate",
      "ScheduleWakeup",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.aws/credentials)",
      "CronDelete",
      "CronList",
      "RemoteTrigger",
      "ReportFindings"
    ]
  }
}

